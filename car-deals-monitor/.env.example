# Copia a .env y rellena. En GitHub Actions defínelas como Secrets del repo.
# Para Gmail debes usar una "contraseña de aplicación" (no tu contraseña normal):
#   https://myaccount.google.com/apppasswords  (requiere verificación en 2 pasos)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion_de_16_caracteres
EMAIL_FROM=tu_correo@gmail.com
# Uno o varios destinatarios separados por comas:
EMAIL_TO=tu_correo@gmail.com

# Opcional: ruta del fichero de estado
# STATE_PATH=data/seen.json
